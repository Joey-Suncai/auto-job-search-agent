#!/bin/sh
# Companion-file check (scripts/check_updates.py), then — when the answer rules, the canon audit or the facts they read are
# staged — the form replay (scripts/learn/replay.py --check, JSA-188): a submitted answer that changes without a recorded
# reason, or a rule answer that contradicts his facts, blocks the commit. Skip once with: git commit --no-verify
ROOT=$(git rev-parse --show-toplevel)
if [ -f "$ROOT/scripts/check_updates.py" ]; then
  python3 "$ROOT/scripts/check_updates.py" || exit 1
fi
if [ -f "$ROOT/scripts/learn/replay.py" ] && command -v node >/dev/null 2>&1 && \
   git diff --cached --name-only | grep -qE '^(skills/auto-apply/scripts/answer_rules\.js|skills/auto-apply/runner/(rules_bridge\.js|canon\.py)|config/(profile|canonical|connections)\.json)$'; then
  python3 "$ROOT/scripts/learn/replay.py" --check || exit 1
fi
exit 0
