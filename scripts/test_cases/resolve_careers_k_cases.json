[
 {
  "name": "targets: spot-check rejected match is never retried",
  "fn": "targets",
  "args": {
   "jobs": [
    {
     "id": "j1",
     "url": "https://jobright.ai/jobs/info/111",
     "elig": "可投",
     "ats_unresolved": "spot-check: reviewer rejected this match"
    },
    {
     "id": "j2",
     "url": "https://jobright.ai/jobs/info/222",
     "elig": "可投"
    }
   ]
  },
  "expect": [
   "j2"
  ],
  "spec_quote": "its `ats_unresolved` does not start with `spot-check:` (a match a reviewer rejected is never tried again)",
  "ambiguous": false
 },
 {
  "name": "targets: other ats_unresolved text does not block the row",
  "fn": "targets",
  "args": {
   "jobs": [
    {
     "id": "j1",
     "url": "https://joinhandshake.com/jobs/9",
     "elig": "待核实",
     "ats_unresolved": "no ats detected, needs manual look"
    }
   ]
  },
  "expect": [
   "j1"
  ],
  "spec_quote": "Other `ats_unresolved` texts do not matter.",
  "ambiguous": false
 },
 {
