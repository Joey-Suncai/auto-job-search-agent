 {
  "name": "systems_back: string ident stays a string",
  "fn": "systems_back",
  "args": {
   "systems": [
    [
     "greenhouse",
     "acme"
    ],
    [
     "lever",
     "acme-lever"
    ]
   ]
  },
  "expect": [
   [
    "greenhouse",
    "acme",
    "str"
   ],
   [
    "lever",
    "acme-lever",
    "str"
   ]
  ],
  "spec_quote": "an ident is a string, or (for Workday) a list of strings; when read back, a list ident becomes a tuple, a string ident stays a string.",
  "ambiguous": false
 },
