 {
  "name": "checkpoint: truncated last line skipped, other lines still count",
  "fn": "checkpoint",
  "args": {
   "file_lines": [
    "{\"key\": \"K1\"}",
    "{\"t\": \"comp\", \"c\": \"Acme\", \"s\": [], \"site\": \"acme.com\", \"note\": \"\", \"reason\": \"\"}",
    "{\"t\": \"row\", \"id\": \"r1\", \"r\": 1}",
    "{\"t\": \"row\", \"id\": \"r2\", \"r\": {\"half\": "
   ],
   "no_path": false,
   "key": "K1",
   "fresh": false,
   "puts": []
  },
  "expect": {
   "comp": {
    "Acme": [
     [],
     "acme.com",
     "",
     ""
    ]
   },
   "render": {},
   "rows": {
    "r1": 1
   },
   "resumed": 2,
   "file_after": [
    {
     "key": "K1"
    },
    {
     "t": "comp",
     "c": "Acme",
     "s": [],
     "site": "acme.com",
     "note": "",
     "reason": ""
    },
    {
     "t": "row",
     "id": "r1",
     "r": 1
    }
   ]
  },
  "spec_quote": "A line that is not valid JSON (for example the last line, cut off when the run was killed) is skipped; the other lines still count.",
  "ambiguous": true,
  "why": "The loading rule is clear, but the spec never says whether a resumed run rewrites the file or only appends via put(); since file_after must be parsed JSON, the trailing invalid line cannot be represented. The listed file_after assumes the invalid line is left in place and simply not reported."
 },
