 {
  "name": "checkpoint: no file on disk, nothing resumed, header written",
  "fn": "checkpoint",
  "args": {
   "file_lines": null,
   "no_path": false,
   "key": "K1",
   "fresh": false,
   "puts": []
  },
  "expect": {
   "comp": {},
   "render": {},
   "rows": {},
   "resumed": 0,
   "file_after": [
    {
     "key": "K1"
    }
   ]
  },
  "spec_quote": "Otherwise (no file, a different key, an empty file, or `fresh`) nothing is loaded and the file is started over: it then contains only the header line for `key`.",
  "ambiguous": false
 },
 {
  "name": "checkpoint: matching key resumes comp, render and row",
  "fn": "checkpoint",
  "args": {
   "file_lines": [
    "{\"key\": \"K1\"}",
    "{\"t\": \"comp\", \"c\": \"Acme\", \"s\": [[\"greenhouse\", \"acme\"]], \"site\": \"acme.com\", \"note\": \"n1\", \"reason\": \"r1\"}",
    "{\"t\": \"render\", \"site\": \"beta.com\", \"s\": [[\"workday\", [\"beta\", \"Ext\"]]], \"note\": \"n2\"}",
    "{\"t\": \"row\", \"id\": \"row1\", \"r\": {\"status\": \"ok\"}}"
   ],
   "no_path": false,
   "key": "K1",
   "fresh": false,
   "puts": []
  },
  "expect": {
   "comp": {
    "Acme": [
     [
      [
       "greenhouse",
       "acme"
      ]
     ],
     "acme.com",
     "n1",
     "r1"
    ]
   },
   "render": {
    "beta.com": [
     [
      [
       "workday",
       [
        "beta",
        "Ext"
       ]
      ]
     ],
     "n2"
    ]
   },
   "rows": {
    "row1": {
     "status": "ok"
    }
   },
   "resumed": 3,
   "file_after": [
    {
     "key": "K1"
    },
    {
     "t": "comp",
     "c": "Acme",
     "s": [
      [
       "greenhouse",
       "acme"
      ]
     ],
     "site": "acme.com",
     "note": "n1",
     "reason": "r1"
    },
    {
     "t": "render",
     "site": "beta.com",
     "s": [
      [
       "workday",
       [
        "beta",
        "Ext"
       ]
      ]
     ],
     "note": "n2"
    },
    {
     "t": "row",
     "id": "row1",
     "r": {
      "status": "ok"
     }
    }
   ]
  },
  "spec_quote": "The file is used only when it exists, `fresh` is false, and its first readable line has `\"key\"` equal to `key`. Then every comp / render / row line is loaded",
  "ambiguous": false
 },
