 {
  "name": "search_url_easy_true_start_positive",
  "fn": "search_url",
  "args": {
   "keyword": "data science intern",
   "easy": true,
   "start": 25
  },
  "expect": {
   "path": "/jobs/search/",
   "query": {
    "keywords": "data science intern",
    "geoId": "103644278",
    "f_E": "1",
    "f_AL": "true",
    "start": "25"
   }
  },
  "spec": "f_AL = true is present only when easy is true; absent otherwise. start is present only when start > 0 (its decimal value)."
 },
 {
  "name": "search_url_encoded_keyword_start_zero_absent",
  "fn": "search_url",
  "args": {
   "keyword": "C++ & R (entry-level)",
   "easy": true,
   "start": 0
  },
  "expect": {
   "path": "/jobs/search/",
   "query": {
    "keywords": "C++ & R (entry-level)",
    "geoId": "103644278",
    "f_E": "1",
    "f_AL": "true"
   }
  },
  "spec": "keywords = the keyword exactly as given (URL-encoded) ... start is present only when start > 0 (its decimal value); absent when 0."
 },
 {
  "name": "search_url_no_easy_flag_start_present",
  "fn": "search_url",
  "args": {
   "keyword": "software engineering intern",
   "easy": false,
   "start": 50
  },
  "expect": {
   "path": "/jobs/search/",
   "query": {
    "keywords": "software engineering intern",
    "geoId": "103644278",
    "f_E": "1",
    "start": "50"
   }
  },
  "spec": "f_AL = true is present only when easy is true; absent otherwise. No other parameters (in particular no f_TPR, no location parameter)."
 },
 {
  "name": "parse_count_other_numbers_before_count",
  "fn": "parse_count",
  "args": {
   "text": "Showing 1-20 of 2,345 results"
  },
  "expect": 2345,
  "spec": "Find the FIRST place where a number is followed (optionally by \"+\", then optional spaces) by the word \"result\" or \"results\" ... Numbers may contain thousands commas (\"12,345\" → 12345)."
 },
 {
  "name": "parse_count_number_not_directly_before_results_r2",
  "fn": "parse_count",
  "args": {
   "text": "3 new results for your search — see all 128 results"
  },
  "expect": 128,
  "spec": "A number not directly followed by result/results (only \"+\" and spaces may sit between) is ignored: in \"3 new results\" the 3 is not a count."
 },
 {
  "name": "parse_count_over_decimal_k_plus",
  "fn": "parse_count",
  "args": {
   "text": "Over 2.5K+ results"
  },
  "expect": 2500,
  "spec": "A preceding \"Over\" / \"About\" does not change the number ... A \"K\" / \"k\" suffix right after the number means thousands (\"2.5K results\" → 2500; round to the nearest whole number)."
 },
 {
  "name": "parse_count_no_matching_jobs_mixed_case",
  "fn": "parse_count",
  "args": {
   "text": "Sorry, no jobs here. No Matching Jobs Found for that search."
  },
  "expect": 0,
  "spec": "If there is no such count but the text contains \"No matching jobs found\" (case-insensitive) → 0."
 },
 {
  "name": "parse_count_jobs_and_lone_results_word_give_none",
  "fn": "parse_count",
  "args": {
   "text": "25 new jobs. Results are loading."
  },
  "expect": null,
  "spec": "Otherwise → None (e.g. empty text, text without a count, \"25 jobs\", \"results\" with no number before it)."
 },
 {
  "name": "classify_button_easy_apply_wins_over_applied",
  "fn": "classify_button",
  "args": {
   "text": "Applied on May 3 · Easy Apply"
  },
  "expect": "easy",
  "spec": "1. Contains \"easy apply\" → \"easy\" ... The rules are checked in that order; the first that matches decides."
 },
 {
  "name": "classify_button_applied_in_sentence",
  "fn": "classify_button",
  "args": {
   "text": "You applied to this job"
  },
  "expect": "unknown",
  "spec": "2. Else contains \"applied\", \"application submitted\" or \"no longer accepting\" → \"unknown\" (already applied / closed)."
 },
 {
  "name": "classify_button_no_longer_accepting_r2",
  "fn": "classify_button",
  "args": {
   "text": "No Longer Accepting Applications"
  },
  "expect": "unknown",
  "spec": "Else contains \"applied\", \"application submitted\" or \"no longer accepting\" → \"unknown\" ... Compare case-insensitively with runs of whitespace treated as one space."
 },
 {
  "name": "classify_button_whitespace_runs_external",
  "fn": "classify_button",
  "args": {
   "text": "Apply   on   company\nwebsite"
  },
  "expect": "external",
  "spec": "Else contains the whole word \"apply\" → \"external\" ... runs of whitespace treated as one space."
 },
 {
  "name": "link_target_redirect_decoded_www_and_port",
  "fn": "link_target",
  "args": {
   "href": "https://www.linkedin.com/redir/redirect?url=https%3A%2F%2Fwww.acme.com%3A8443%2Fcareers%2Fapply&trk=abc"
  },
  "expect": "acme.com",
  "spec": "A LinkedIn redirect — host linkedin.com or www.linkedin.com, path starting /redir/redirect or /safety/go, with a query parameter url — → the host of the decoded url parameter (same lowercase / no-\"www.\" rule)."
 },
 {
  "name": "link_target_redirect_without_url_param",
  "fn": "link_target",
  "args": {
   "href": "https://www.linkedin.com/redir/redirect?trk=abc&refId=1"
  },
  "expect": "linkedin",
  "spec": "A LinkedIn redirect ... with a query parameter url — → the host of the decoded url parameter. Any other URL whose host is linkedin.com or ends with .linkedin.com → \"linkedin\"."
 },
 {
  "name": "link_target_redirect_non_http_url_param",
  "fn": "link_target",
  "args": {
   "href": "https://www.linkedin.com/safety/go?url=mailto%3Ajobs%40acme.com"
  },
  "expect": "",
  "spec": "→ the host of the decoded url parameter (same lowercase / no-\"www.\" rule; \"\" if that is not an http(s) URL)."
 },
 {
  "name": "link_target_linkedin_subdomain",
  "fn": "link_target",
  "args": {
   "href": "https://jobs.linkedin.com/jobs/view/42"
  },
  "expect": "linkedin",
  "spec": "Any other URL whose host is linkedin.com or ends with .linkedin.com → \"linkedin\"."
 },
 {
  "name": "card_easy_stripped_case_insensitive_r2",
  "fn": "card_easy",
  "args": {
   "lines": [
    "Acme Corp — Data Intern",
    "  easy APPLY  ",
    "2 days ago"
   ]
  },
  "expect": true,
  "spec": "True when any line, stripped, equals \"Easy Apply\" (case-insensitive); False otherwise."
 },
 {
  "name": "card_easy_split_words_and_longer_line",
  "fn": "card_easy",
  "args": {
   "lines": [
    "Easy",
    "Apply",
    "Easy Apply available soon"
   ]
  },
  "expect": false,
  "spec": "True when any line, stripped, equals \"Easy Apply\" (case-insensitive); False otherwise (also for an empty list, or a line such as \"Easy Apply available soon\")."
 },
 {
  "name": "card_easy_empty_list",
  "fn": "card_easy",
  "args": {
   "lines": []
  },
  "expect": false,
  "spec": "False otherwise (also for an empty list ...)."
 },
 {
  "name": "pick_sample_n_larger_than_all_ids",
  "fn": "pick_sample",
  "args": {
   "groups": [
    [
     "a",
     [
      1,
      2
     ]
    ],
    [
     "b",
     [
      3
     ]
    ]
   ],
   "n": 10
  },
  "expect": [
   1,
   3,
   2
  ],
  "spec": "Take ids round-robin: the 1st id of each group in group order, then the 2nd id of each group, and so on ... stop at n ids or when every group is used up. Groups with fewer ids simply run out."
 },
 {
  "name": "pick_sample_duplicate_id_skipped",
  "fn": "pick_sample",
  "args": {
   "groups": [
    [
     "a",
     [
      10,
      11
     ]
    ],
    [
     "b",
     [
      11,
      12
     ]
    ]
   ],
   "n": 3
  },
  "expect": [
   10,
   11,
   12
  ],
  "spec": "Take ids round-robin ... skip an id already taken; stop at n ids."
 },
 {
  "name": "pick_sample_n_zero_r2",
  "fn": "pick_sample",
  "args": {
   "groups": [
    [
     "kw",
     [
      7,
      8
     ]
    ]
   ],
   "n": 0
  },
  "expect": [],
  "spec": "n ≤ 0 → []."
 },
