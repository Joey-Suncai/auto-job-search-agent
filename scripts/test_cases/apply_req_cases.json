 {
  "name": "validate valid request with query string and localhost origin any port",
  "fn": "validate",
  "args": {
   "method": "POST",
   "path": "/apply?x=1",
   "headers": {
    "host": "localhost:8766",
    "origin": "http://127.0.0.1:3000",
    "x-jsa-pref": "1",
    "content-type": "application/json; charset=utf-8"
   },
   "body": "{\"job_id\":\"J1234\",\"confirm\":true}"
  },
  "expect": 200
 },
 {
  "name": "validate bad host port",
  "fn": "validate",
