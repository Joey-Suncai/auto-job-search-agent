[
 {
  "name": "skip_names basic comments blanks order",
  "fn": "skip_names",
  "args": {
   "text": "# comment\nAcme Corp|score 7\n\n  Beta Ltd  |x\nGamma\n"
  },
  "expect": [
   "acme corp",
   "beta ltd",
   "gamma"
  ]
 },
 {
  "name": "skip_names empty names dropped before first pipe",
  "fn": "skip_names",
  "args": {
   "text": "|score\n   |  \nDelta|a|b\n"
  },
  "expect": [
   "delta"
  ]
 },
 {
  "name": "skip_names lowercases and keeps duplicates in order",
  "fn": "skip_names",
  "args": {
   "text": "Epsilon\n  epsilon  |dup\nEPSILON|dup2\n"
  },
  "expect": [
   "epsilon",
   "epsilon",
   "epsilon"
  ]
 },
