   "now": "2026-11-05T12:00:00Z",
   "note": "retry",
   "by": ""
  },
  "expect": {
   "id": "J1",
   "company": "Acme",
   "apply_req": "queued",
   "apply_req_at": "2026-11-05T12:00:00Z",
   "apply_req_note": "retry",
   "apply_req_by": "alice"
  }
 },
