 {
  "name": "queued filters, sorts by at then id, fills missing title",
  "fn": "queued",
  "args": {
   "rows": [
    {
     "apply_req": "queued",
     "apply_req_at": "2026-11-05T09:00:00",
     "id": "J2",
     "company": "B",
     "title": "T2"
    },
    {
     "apply_req": "applying",
     "apply_req_at": "2026-11-05T08:00:00",
     "id": "J1",
     "company": "A",
     "title": "T1"
    },
    {
     "apply_req": "queued",
     "apply_req_at": "2026-11-05T09:00:00",
     "id": "J1",
     "company": "A"
    }
   ]
  },
  "expect": [
   [
    "2026-11-05T09:00:00",
    "J1",
    "A",
    ""
   ],
   [
    "2026-11-05T09:00:00",
    "J2",
    "B",
    "T2"
   ]
  ]
 },
 {
