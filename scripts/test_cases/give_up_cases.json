[
 {
  "name": "decline basic give_up records old state and clears action",
  "fn": "decline",
  "row": {
   "job_id": "J1234",
   "company": "Acme Corp",
   "status": "Applied",
   "action_needed": "Complete assessment",
   "action_deadline": "2026-11-20",
   "action_done": [
    {
     "on": "2026-11-02",
     "action": "Started"
    }
   ],
   "next_step": "Wait for reply",
   "updated": "2026-11-01"
  },
  "give_up": true,
  "today": "2026-11-17",
  "expect_row": {
   "job_id": "J1234",
   "company": "Acme Corp",
   "status": "Declined by Joey",
   "action_needed": "",
   "action_deadline": "",
   "action_done": [
    {
     "on": "2026-11-02",
     "action": "Started"
    }
   ],
   "next_step": "Declined by Joey 2026-11-17",
   "updated": "2026-11-17",
   "declined": {
    "on": "2026-11-17",
    "status": "Applied",
    "action": "Complete assessment",
    "deadline": "2026-11-20",
    "next_step": "Wait for reply"
   }
  },
  "expect_error": null,
  "spec_quote": "else new row: `declined` = {\"on\": today, \"status\": <old status>, \"action\": <action_needed trimmed>, \"deadline\": <old action_deadline or \"\">, \"next_step\": <old next_step or \"\">}; status = \"Declined by Joey\"; action_needed = \"\"; action_deadline = \"\"; next_step = \"Declined by Joey \" + today; updated = today. error = null. Nothing else changes (action_done history stays as it was)."
 },
