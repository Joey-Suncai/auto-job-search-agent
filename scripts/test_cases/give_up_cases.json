 {
  "name": "validate accepts a well-formed /decline POST with query string",
  "fn": "validate",
  "method": "POST",
  "path": "/decline?job=J1234",
  "headers": {
   "host": "localhost:5173",
   "origin": "http://localhost:5173",
   "x-jsa-pref": "1",
   "content-type": "Application/JSON; charset=utf-8"
  },
  "body": "{\"job_id\":\"J1234\",\"give_up\":true}",
  "expect_code": 200,
  "expect_payload": {
   "route": "/decline",
   "job_id": "J1234",
   "give_up": true
  },
  "spec_quote": "path (query string ignored) must be one of /pref, /action, /apply, /decline ... content-type starts with application/json (case-insensitive) else 415 ... Success → (200, {\"route\": \"/decline\", \"job_id\": <job_id>, \"give_up\": <give_up>})."
 },
 {
  "name": "validate rejects foreign Host header with 421",
  "fn": "validate",
  "method": "POST",
  "path": "/decline",
  "headers": {
   "host": "evil.example.com:8080",
   "origin": "http://localhost:5173",
   "x-jsa-pref": "1",
   "content-type": "application/json"
  },
  "body": "{\"job_id\":\"J1234\",\"give_up\":true}",
  "expect_code": 421,
  "spec_quote": "Host header must be localhost or 127.0.0.1 (optional :port) else 421"
 },
 {
  "name": "validate rejects unknown path with 404",
  "fn": "validate",
  "method": "POST",
  "path": "/decline/extra",
  "headers": {
   "host": "localhost",
   "origin": "http://localhost",
   "x-jsa-pref": "1",
   "content-type": "application/json"
  },
  "body": "{\"job_id\":\"J1234\",\"give_up\":true}",
  "expect_code": 404,
  "spec_quote": "path (query string ignored) must be one of /pref, /action, /apply, /decline else 404"
 },
 {
  "name": "validate rejects GET with 405",
  "fn": "validate",
  "method": "GET",
  "path": "/decline",
  "headers": {
   "host": "127.0.0.1:8080",
   "origin": "http://127.0.0.1:8080",
   "x-jsa-pref": "1",
   "content-type": "application/json"
  },
  "body": "{\"job_id\":\"J1234\",\"give_up\":true}",
  "expect_code": 405,
  "spec_quote": "method must be POST else 405"
 },
 {
  "name": "validate rejects look-alike localhost origin with 403",
  "fn": "validate",
  "method": "POST",
  "path": "/decline",
  "headers": {
   "host": "localhost",
   "origin": "http://localhost.evil.com",
   "x-jsa-pref": "1",
   "content-type": "application/json"
  },
  "body": "{\"job_id\":\"J1234\",\"give_up\":true}",
  "expect_code": 403,
  "spec_quote": "Origin absent, \"null\", or http://localhost[:port] / http://127.0.0.1[:port] else 403"
 },
 {
  "name": "validate rejects missing x-jsa-pref header with 403",
  "fn": "validate",
  "method": "POST",
  "path": "/decline",
  "headers": {
   "host": "localhost",
   "origin": "http://localhost",
   "content-type": "application/json"
  },
  "body": "{\"job_id\":\"J1234\",\"give_up\":true}",
  "expect_code": 403,
  "spec_quote": "header x-jsa-pref exactly \"1\" else 403"
 },
 {
  "name": "validate rejects non-JSON content-type with 415",
  "fn": "validate",
  "method": "POST",
  "path": "/decline",
  "headers": {
   "host": "localhost",
   "origin": "http://localhost",
   "x-jsa-pref": "1",
   "content-type": "text/plain"
  },
  "body": "{\"job_id\":\"J1234\",\"give_up\":true}",
  "expect_code": 415,
  "spec_quote": "content-type starts with application/json (case-insensitive) else 415"
 },
 {
  "name": "validate rejects give_up given as 1 instead of boolean",
  "fn": "validate",
  "method": "POST",
  "path": "/decline",
  "headers": {
   "host": "localhost",
   "origin": "http://localhost",
   "x-jsa-pref": "1",
   "content-type": "application/json"
  },
  "body": "{\"job_id\":\"J12345\",\"give_up\":1}",
  "expect_code": 400,
  "spec_quote": "give_up a JSON boolean (not 0/1, not \"true\"), else 400."
 },
 {
  "name": "todo skips declined rows even when they still have an action",
  "fn": "todo",
  "apps": [
   {
    "job_id": "J1",
    "company": "A",
    "status": "Declined by Joey",
    "action_needed": "Fill form"
   },
   {
    "job_id": "J2",
    "company": "B",
    "status": "Applied",
    "action_needed": "Fill form"
   }
  ],
  "today": "2026-11-17",
  "expect_job_ids": [
   "J2"
  ],
  "spec_quote": "A tracker row whose status is \"Declined by Joey\" yields no to-do row, even when it still has an action_needed."
 },
