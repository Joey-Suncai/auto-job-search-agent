 {
  "name": "wwr: CDATA title with company prefix",
  "fn": "parse_wwr",
  "args": {
   "xml": "<rss version=\"2.0\"><channel><item><title><![CDATA[Acme Corp: Data Analyst Intern]]></title><link>https://weworkremotely.com/remote-jobs/data-analyst-intern-100</link><region>Anywhere in the World</region><type>Full-Time</type></item></channel></rss>"
  },
  "expect": [
   {
    "board": "wwr",
    "id": "data-analyst-intern-100",
    "company": "Acme Corp",
    "title": "Data Analyst Intern",
    "location": "Anywhere in the World",
    "url": "https://weworkremotely.com/remote-jobs/data-analyst-intern-100",
    "type": "Full-Time",
    "visa": ""
   }
  ],
  "spec_quote": "title = the <title> text (a CDATA wrapper removed, HTML entities decoded), link = <link> ... The title is \"Company: Role\": split at the FIRST \": \" → company = left part, title = right part (both trimmed)",
  "ambiguous": false
 },
