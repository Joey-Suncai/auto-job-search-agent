    "type": "Full-time",
    "visa": "Yes"
   }
  ],
  "spec_quote": "id = the last path segment of `url` (a trailing \"/\" ignored); company = `companyName` (trimmed, \"\" when missing); title (trimmed); location (trimmed, \"\" when missing)",
