 {
  "name": "known: yc id from url, wwr id from ats_url, pairs from both keys",
  "fn": "known",
  "args": {
   "rows": [
    {
     "company": "Acme Inc",
     "title": "Data Analyst Intern",
     "url": "https://www.ycombinator.com/companies/acme/jobs/123",
     "ats_url": "https://weworkremotely.com/remote-jobs/wwr-456"
    }
   ]
  },
  "expect": {
   "ids": [
    [
     "wwr",
     "wwr-456"
    ],
    [
     "yc",
     "123"
    ]
   ],
   "pairs_count": 2
  },
  "spec_quote": "ids = the set of (board, id lower-cased) found in url or ats_url: \"ycombinator.com/companies/<slug>/jobs/<id>\" → (\"yc\", id); \"weworkremotely.com/remote-jobs/<id>\" → (\"wwr\", id). pairs = {(norm(company), title_key(title))} ∪ {(norm(company), alt_key(title))} for every row.",
  "ambiguous": false
 },
