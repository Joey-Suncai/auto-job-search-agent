  "fn": "parse_yc",
  "args": {
   "page": "<div data-page=\"{&quot;props&quot;:{&quot;jobPostings&quot;:[{&quot;title&quot;:&quot;  Data Analyst Intern  &quot;,&quot;url&quot;:&quot;/companies/acme/jobs/ABC-1/&quot;,&quot;companyName&quot;:&quot;  Acme  &quot;,&quot;location&quot;:&quot;  New York, NY  &quot;,&quot;type&quot;:&quot;Full-time&quot;,&quot;visa&quot;:&quot;Yes&quot;}]}}\"></div>"
  },
