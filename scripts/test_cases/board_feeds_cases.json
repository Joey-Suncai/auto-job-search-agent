 {
  "name": "yc: entities in data-page, relative url, missing location/type/visa",
  "fn": "parse_yc",
  "args": {
   "page": "<div data-page=\"{&quot;props&quot;:{&quot;jobPostings&quot;:[{&quot;title&quot;:&quot;Data Analyst Intern&quot;,&quot;url&quot;:&quot;/companies/acme/jobs/12345&quot;,&quot;companyName&quot;:&quot;Acme&quot;}]}}\"></div>"
  },
  "expect": [
   {
    "board": "yc",
    "id": "12345",
    "company": "Acme",
    "title": "Data Analyst Intern",
    "location": "",
    "url": "https://www.ycombinator.com/companies/acme/jobs/12345",
    "type": "",
    "visa": ""
   }
  ],
  "spec_quote": "its value, after HTML entities are decoded (&quot; → \"), is JSON; the postings are its `props.jobPostings` list ... url = `url` when it starts with \"http\", else \"https://www.ycombinator.com\" + url; type = `type` (\"\" when missing); visa = `visa` (\"\" when missing).",
  "ambiguous": false
 },
