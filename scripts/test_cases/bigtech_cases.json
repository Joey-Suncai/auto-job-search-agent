[
 {
  "name": "amazon_basic_job_path_normalized",
  "fn": "parse_amazon",
  "args": [
   {
    "jobs": [
     {
      "title": "  Software   Engineer ",
      "normalized_location": " Seattle,   WA ",
      "job_path": "/en/jobs/123"
     }
    ]
   }
  ],
  "expect": [
   {
    "title": "Software Engineer",
    "location": "Seattle, WA",
    "url": "https://www.amazon.jobs/en/jobs/123"
   }
  ]
 },
 {
  "name": "amazon_location_fallback",
  "fn": "parse_amazon",
  "args": [
   {
    "jobs": [
     {
      "title": "Data Scientist",
      "location": " New   York, NY ",
      "job_path": "/en/jobs/456"
     }
    ]
   }
  ],
  "expect": [
   {
    "title": "Data Scientist",
    "location": "New York, NY",
    "url": "https://www.amazon.jobs/en/jobs/456"
   }
  ]
 },
 {
