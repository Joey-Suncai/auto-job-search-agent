    "title": "Valid Role",
    "location": "Austin",
    "url": "https://www.amazon.jobs/en/jobs/2"
   }
  ]
 },
 {
  "name": "apple_res_wrapper_multi_location",
  "fn": "parse_apple",
  "args": [
   {
    "res": {
     "searchResults": [
      {
       "postingTitle": "  iOS   Engineer ",
       "positionId": "P1",
       "transformedPostingTitle": "ios-engineer",
       "locations": [
        {
         "name": " Cupertino,   CA "
        },
        {
         "name": "Austin, TX"
        }
       ]
      }
     ]
    }
   }
  ],
  "expect": [
   {
    "title": "iOS Engineer",
    "location": "Cupertino, CA",
    "url": "https://jobs.apple.com/en-us/details/P1/ios-engineer"
   },
   {
    "title": "iOS Engineer",
    "location": "Austin, TX",
    "url": "https://jobs.apple.com/en-us/details/P1/ios-engineer"
   }
  ]
 },
