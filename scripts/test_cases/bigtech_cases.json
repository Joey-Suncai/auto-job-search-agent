 {
  "name": "amazon_skip_missing_title_or_route",
  "fn": "parse_amazon",
  "args": [
   {
    "jobs": [
     {
      "normalized_location": "Nowhere",
      "job_path": "/en/jobs/1"
     },
     {
      "title": "Valid Role",
      "normalized_location": "Austin",
      "job_path": "/en/jobs/2"
     },
     {
      "title": "No Route",
      "normalized_location": "Boston"
     }
    ]
   }
  ],
  "expect": [
