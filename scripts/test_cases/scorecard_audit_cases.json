 },
 {
  "name": "recert since filters only listed platform by submit time",
  "fn": "window_folders",
  "spec_quote": "For a platform in recert, a folder counts only when its submit time (first 19 characters) >= since (first 19 characters); for other platforms every submitted folder counts.",
  "args": {
   "results": [
    {
     "folder": "2024-02-15_g1",
     "at": "2024-02-15T12:00:00Z",
     "status": "submitted",
     "url": "https://greenhouse.io/a"
    },
    {
     "folder": "2024-03-01_g2",
     "at": "2024-03-01T00:00:00Z",
     "status": "submitted",
     "url": "https://greenhouse.io/b"
    },
    {
     "folder": "2024-03-02_g3",
     "at": "2024-03-02T12:00:00Z",
     "status": "submitted",
     "url": "https://greenhouse.io/c"
    },
    {
     "folder": "2024-02-15_w1",
     "at": "2024-02-15T12:00:00Z",
     "status": "submitted",
     "url": "https://myworkday.com/a"
    }
   ],
   "recert": {
    "greenhouse": {
     "since": "2024-03-01T00:00:00"
    }
   }
  },
  "expect": {
   "greenhouse": [
    "2024-03-01_g2",
    "2024-03-02_g3"
   ],
   "workday": [
    "2024-02-15_w1"
   ]
  }
 },
