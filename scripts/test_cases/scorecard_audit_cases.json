 {
  "name": "basic platform mapping for all platforms and other fallback",
  "fn": "window_folders",
  "spec_quote": "A folder's platform comes from its EARLIEST line: url containing \"greenhouse\" → greenhouse, \"myworkday\" → workday, \"lever.co\" → lever, \"ashbyhq\" → ashby; else that line's \"ats\"; else \"other\".",
  "args": {
   "results": [
    {
     "folder": "2024-01-01_a",
     "at": "2024-01-01T10:00:00Z",
     "status": "submitted",
     "url": "https://boards.greenhouse.io/company"
    },
    {
     "folder": "2024-01-02_b",
     "at": "2024-01-02T10:00:00Z",
     "status": "submitted",
     "url": "https://company.myworkday.com/job"
    },
    {
     "folder": "2024-01-03_c",
     "at": "2024-01-03T10:00:00Z",
     "status": "submitted",
     "url": "https://jobs.lever.co/company"
    },
    {
     "folder": "2024-01-04_d",
     "at": "2024-01-04T10:00:00Z",
     "status": "submitted",
     "url": "https://jobs.ashbyhq.com/company"
    },
    {
     "folder": "2024-01-05_e",
     "at": "2024-01-05T10:00:00Z",
     "status": "submitted",
     "ats": "customats"
    },
    {
     "folder": "2024-01-06_f",
     "at": "2024-01-06T10:00:00Z",
     "status": "submitted"
    }
   ],
   "recert": null
  },
  "expect": {
   "greenhouse": [
    "2024-01-01_a"
   ],
   "workday": [
    "2024-01-02_b"
   ],
   "lever": [
    "2024-01-03_c"
   ],
   "ashby": [
    "2024-01-04_d"
   ],
   "customats": [
    "2024-01-05_e"
   ],
   "other": [
    "2024-01-06_f"
   ]
  }
 },
 {
  "name": "platform comes from earliest line, not submitted line",
  "fn": "window_folders",
  "spec_quote": "A folder's platform comes from its EARLIEST line: url containing \"greenhouse\" → greenhouse, \"myworkday\" → workday, \"lever.co\" → lever, \"ashbyhq\" → ashby; else that line's \"ats\"; else \"other\".",
  "args": {
   "results": [
    {
