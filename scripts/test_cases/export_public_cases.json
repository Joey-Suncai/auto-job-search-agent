 {
  "name": "phone_bare_ten_digits",
  "fn": "phone_re",
  "phone": "5550102030",
  "text": "5550102030",
  "expect": true
 },
 {
  "name": "phone_dashed",
  "fn": "phone_re",
  "phone": "555-010-2030",
  "text": "555-010-2030",
  "expect": true
 },
 {
  "name": "phone_dotted",
  "fn": "phone_re",
  "phone": "555.010.2030",
  "text": "Call 555.010.2030 now",
  "expect": true
 },
 {
  "name": "phone_parenthesized",
  "fn": "phone_re",
  "phone": "(555) 010-2030",
  "text": "Tel: (555) 010-2030.",
  "expect": true
 },
 {
  "name": "phone_plus_one_spaces",
  "fn": "phone_re",
  "phone": "+1 555 010 2030",
  "text": "dial +1 555 010 2030 today",
  "expect": true
 },
 {
  "name": "phone_one_dashes",
  "fn": "phone_re",
  "phone": "1-555-010-2030",
  "text": "1-555-010-2030",
  "expect": true
 },
 {
  "name": "phone_embedded_in_long_digit_run",
  "fn": "phone_re",
  "phone": "5550102030",
  "text": "14479027580123",
  "expect": false
 },
 {
  "name": "phone_different_number",
  "fn": "phone_re",
  "phone": "5550102030",
  "text": "555-123-4567",
  "expect": false
 },
 {
  "name": "phone_fewer_than_ten_digits",
  "fn": "phone_re",
  "phone": "12345",
  "text": "12345",
  "expect": null
 },
 {
  "name": "find_hits_basic_line_number",
  "fn": "find_hits",
  "rel": "notes/scan.md",
  "text": "hello\nphone: 555-010-2030",
  "terms": [
   [
    "phone",
    "\\d{3}-\\d{3}-\\d{4}"
   ]
  ],
  "expect": [
   "notes/scan.md:2: phone: 555-010-2030"
  ]
 },
 {
  "name": "find_hits_no_match",
  "fn": "find_hits",
  "rel": "notes/none.md",
  "text": "nothing here",
  "terms": [
   [
    "phone",
    "\\d{10}"
   ]
  ],
  "expect": []
 },
 {
  "name": "find_hits_license_allowlist_skipped",
  "fn": "find_hits",
  "rel": "LICENSE",
  "text": "legal first name: Ellis",
  "terms": [
   [
    "legal first name",
    "legal first name"
   ]
  ],
  "expect": []
 },
 {
  "name": "find_hits_case_insensitive_default",
  "fn": "find_hits",
  "rel": "config/app.js",
  "text": "const Email = 1;",
  "terms": [
   [
    "email",
    "email"
   ]
  ],
  "expect": [
   "config/app.js:1: email: Email"
  ]
 },
 {
  "name": "find_hits_allowlist_only_for_listed_pair",
  "fn": "find_hits",
  "rel": "LICENSE",
  "text": "legal first name: Ellis\nCopyright 2024 Ellis",
  "terms": [
   [
    "legal first name",
    "first name"
   ],
   [
    "copyright",
    "Copyright"
   ]
  ],
  "expect": [
   "LICENSE:2: copyright: Copyright"
  ]
 },
 {
  "name": "render_multi_placeholder_and_escape",
  "fn": "render",
  "template": "<string>{{REPO}}/{{LABEL}}</string>",
  "values": {
   "REPO": "/Users/x",
   "LABEL": "a & b <c>"
  },
  "expect": "<string>/Users/x/a &amp; b &lt;c&gt;</string>"
 },
 {
  "name": "render_repeated_placeholder",
  "fn": "render",
  "template": "<string>{{REPO}}</string><string>{{REPO}}</string>",
  "values": {
   "REPO": "/x"
  },
  "expect": "<string>/x</string><string>/x</string>"
 },
 {
  "name": "render_missing_key_error",
  "fn": "render",
  "template": "<string>{{REPO}}</string>",
  "values": {},
  "expect": "error"
 },
 {
  "name": "render_empty_value_error",
  "fn": "render",
  "template": "<string>{{REPO}}</string>",
  "values": {
   "REPO": ""
  },
  "expect": "error"
 },
 {
  "name": "render_no_placeholders_unchanged",
  "fn": "render",
  "template": "<plist><dict/></plist>",
  "values": {},
  "expect": "<plist><dict/></plist>"
 }
]