 {
  "name": "line_waiting_with_summary",
  "fn": "line",
  "spec_quote": "it starts with \"prefetch questions: <len(ids)> waiting on <name> — answering them makes <G> more of <J> prefetched jobs ready (<N> ready now).\" where N = summary.ready_now, J = summary.jobs, G = max(summary.ready_after - summary.ready_now, 0)",
  "sheet": {
   "name": "daily",
   "summary": {
    "ready_now": 3,
    "ready_after": 7,
    "jobs": 10
   }
  },
  "ids": [
   "q1",
   "q2"
  ],
  "expect_prefix": "prefetch questions: 2 waiting on daily — answering them makes 4 more of 10 prefetched jobs ready (3 ready now)."
