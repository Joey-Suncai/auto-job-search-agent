 {
  "name": "choice_map_boolean_with_choices_only_yes_no",
  "fn": "choice_map",
  "args": [
   [
    {
     "name": "S",
     "fields": [
      {
       "id": "QA_flag",
       "type": "boolean",
       "label": "Flag",
       "choices": [
        {
         "id": 9,
         "body": "Maybe"
        }
       ]
      },
      {
       "id": "QA_pick",
       "type": "multiple",
       "label": "Pick",
       "choices": [
        {
         "id": "abc",
         "body": "Option A"
        },
        {
         "id": "def",
         "name": "Option B"
        }
       ]
      }
     ]
    }
   ]
  ],
  "expect": {
   "QA_flag": {
    "Yes": "true",
    "No": "false"
   },
   "QA_pick": {
    "Option A": "abc",
    "Option B": "def"
   }
  },
  "ambiguous": true,
  "why": "The spec says booleans map Yes/'true', No/'false' and that fields with choices/options are mapped, but it does not say whether a boolean field that also carries a 'choices' list should additionally include those choice texts; only the Yes/No mapping is assumed here."
 },
 {
  "name": "choice_map_empty_options_list_and_whitespace_in_choice_body",
  "fn": "choice_map",
  "args": [
   [
    {
     "name": "S",
     "fields": [
      {
       "id": "CA_other",
       "type": "multiple",
       "label": "Other",
       "options": []
      },
      {
       "id": "QA_dept",
       "type": "dropdown",
       "label": "Dept",
       "choices": [
        {
         "id": "42",
         "body": "  Engineering   &  Ops "
        },
        {
         "id": "43",
         "body": "Design"
        }
       ]
      }
     ]
