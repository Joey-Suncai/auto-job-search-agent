  "ambiguous": true,
  "ambiguous_note": "The spec only says the covered line 'then it counts (also as recert_wrong when critical)'. It does not state whether an uncovered critical wrong in a recert-window folder should also increment recert_wrong. The expected value here assumes recert_wrong counts only covered critical lines that are counted because of the recert window.",
  "args": {
   "submits": [
    {
     "folder": "2026-11-05_Alpha",
     "at": "2026-11-05T10:00:00",
     "platform": "greenhouse"
    }
   ],
   "wrong": [
    {
     "folder": "2026-11-05_Alpha",
     "field": "dob",
     "class": "critical"
    }
   ],
