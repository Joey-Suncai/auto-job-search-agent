 {
  "id": "cf-01",
  "fn": "clear_flag",
  "input": {
   "batch": {
    "jobs": [
     {
      "id": "j1",
      "company": "Acme"
     },
     {
      "id": "j2",
      "company": "Beta"
     }
    ]
   },
   "ident": "j1",
   "by": "Joey",
   "note": "checked, fine",
   "at": "2024-05-01T10:00:00Z"
  },
  "expect": {
   "job_id": "j1",
   "flag_cleared": {
    "by": "Joey",
    "at": "2024-05-01T10:00:00Z",
    "note": "checked, fine"
   }
  },
  "spec": "The matched job gets flag_cleared {\"by\": by.strip(), \"at\": at, \"note\": note.strip()}"
 },
 {
  "id": "cf-02",
  "fn": "clear_flag",
  "input": {
   "batch": {
    "jobs": [
     {
      "id": "j1",
      "company": "Acme"
     },
     {
      "id": "j2",
      "company": "Beta"
     }
    ]
   },
   "ident": "  aCme  ",
   "by": "Joey",
   "note": "ok",
   "at": "2024-05-01T10:00:00Z"
  },
  "expect": {
   "job_id": "j1",
   "flag_cleared": {
    "by": "Joey",
    "at": "2024-05-01T10:00:00Z",
    "note": "ok"
   }
  },
  "spec": "`ident` selects one job: it equals the job's id (as string) or, if no id matches, the job's company (case-insensitive, surrounding spaces ignored)."
 },
