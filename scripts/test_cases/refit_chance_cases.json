   }
  },
  "spec_quote": "(today − applied_on) in days ≥ min_days (exactly min_days days old IS included). Reason strings: ... \"applied < {min_days} days ago\".",
  "ambiguous": false
 },
 {
  "name": "build_sample_exclusion_order_counts_once",
  "fn": "build_sample",
  "input": {
   "apps": [
    {
     "status": "Withdrawn",
     "applied_on": "bad-date",
     "job_id": "zzz",
     "company": "A"
    },
    {
     "status": "Offer",
     "applied_on": null,
     "job_id": "zzz",
     "company": "B"
    },
    {
     "status": "Offer",
     "applied_on": "2024-01-01",
     "job_id": "zzz",
     "company": "C"
    }
   ],
   "jobs": {},
   "today": "2024-06-01",
   "min_days": 1
  },
  "expect": {
   "n": 0,
   "ys": [],
   "excluded": {
    "not submitted / unknown status": 1,
    "no applied_on": 1,
    "job not in jobs.jsonl": 1
   }
  },
  "spec_quote": "the order of checks is: status, applied_on, age, job lookup (a row is counted once, under the first failing check).",
  "ambiguous": false
 },
