 {
  "name": "build_sample_basic_used_and_excluded",
  "fn": "build_sample",
  "input": {
   "apps": [
    {
     "status": "Interview",
     "applied_on": "2024-01-01",
     "job_id": "j1",
     "company": "A"
    },
    {
     "status": "Rejected",
     "applied_on": "2024-01-02",
     "job_id": "j2",
     "company": "B"
    },
    {
     "status": "Shortlisted",
     "applied_on": "2024-01-01",
     "job_id": "j1",
     "company": "A"
    }
   ],
   "jobs": {
    "j1": {
     "s_referral": 0.5,
     "s_timing": 0.2,
     "s_sponsor": 0.1,
     "s_fresh": 0.9
    },
    "j2": {
     "s_referral": 0.3,
     "s_timing": 0.4,
     "s_sponsor": 0.2,
     "s_fresh": 0.5
    }
   },
   "today": "2024-01-10",
   "min_days": 5
  },
  "expect": {
   "n": 2,
   "ys": [
    1,
    0
   ],
   "xs": [
    [
     0.5,
     0.2,
     0.1,
     0.9
    ],
    [
     0.3,
     0.4,
     0.2,
     0.5
    ]
   ],
   "excluded": {
    "not submitted / unknown status": 1
   }
  },
  "spec_quote": "A row is used only when: outcome(status) is not None; applied_on parses as a date; (today − applied_on) in days ≥ min_days ...; job_id is a key of jobs. Each used row → {\"x\": [s_referral, s_timing, s_sponsor, s_fresh] as floats, \"y\": outcome}. Rows not used are counted in `excluded` by reason.",
  "ambiguous": false
 },
 {
  "name": "build_sample_age_boundary_exact_min_days_included",
  "fn": "build_sample",
  "input": {
   "apps": [
    {
     "status": "Offer",
     "applied_on": "2024-03-03",
     "job_id": "j1",
     "company": "A"
    },
    {
     "status": "Offer",
     "applied_on": "2024-03-04",
     "job_id": "j1",
     "company": "A"
    }
   ],
   "jobs": {
    "j1": {
     "s_referral": 0.2,
     "s_timing": 0.2,
     "s_sponsor": 0.2,
     "s_fresh": 0.2
    }
   },
   "today": "2024-03-10",
   "min_days": 7
  },
  "expect": {
   "n": 1,
   "ys": [
    1
   ],
   "excluded": {
