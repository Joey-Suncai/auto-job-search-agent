 {
  "name": "normalise_keeps_existing_prior",
  "fn": "normalise",
  "input": {
   "beta": [
    0.4,
    0.25,
    0.2,
    0.15
   ]
  },
  "expect": {
   "weights": [
    0.4,
    0.25,
    0.2,
    0.15
   ]
  },
  "spec_quote": "Negative coefficients count as 0; the result is the positive parts divided by their sum, so it sums to 1.",
  "ambiguous": false
 },
