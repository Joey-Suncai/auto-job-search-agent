 {
  "name": "fit_map_finite_and_var_le_prior_separable",
  "fn": "fit_map",
  "input": {
   "rows": [
    {
     "x": [
      1,
      1,
      1,
      1
     ],
     "y": 1
    },
    {
     "x": [
      0.9,
      0.9,
      0.9,
      0.9
     ],
     "y": 1
    },
    {
     "x": [
      0,
      0,
      0,
      0
     ],
     "y": 0
    },
    {
     "x": [
      0.1,
      0.1,
      0.1,
      0.1
     ],
     "y": 0
    }
   ],
   "mu": [
    0,
    0,
    0,
    0,
    0
   ],
   "sd": [
    1,
    1,
    1,
    1,
    1
   ]
  },
  "expect": {
   "finite": true,
   "var_le_prior": true
  },
  "spec_quote": "Adding more data never increases any posterior variance above the prior variance (diagonal of covariance ≤ sd² for each coefficient). Results are finite even when the data are perfectly separable (the prior keeps them finite).",
  "ambiguous": false
 },
