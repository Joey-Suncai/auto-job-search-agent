[
 {
  "name": "standard apply.workable.com URL",
  "fn": "parse_posting",
  "args": [
   "https://apply.workable.com/acme/j/ABC123/"
  ],
  "expect": {
   "account": "acme",
   "shortcode": "ABC123"
  }
 },
 {
  "name": "URL with /apply/ suffix",
  "fn": "parse_posting",
  "args": [
   "https://apply.workable.com/acme/j/ABC123/apply/"
  ],
  "expect": {
   "account": "acme",
   "shortcode": "ABC123"
  }
 },
 {
  "name": "URL with query string",
  "fn": "parse_posting",
  "args": [
   "https://apply.workable.com/acme/j/ABC123/?utm_source=linkedin&ref=1"
  ],
  "expect": {
   "account": "acme",
   "shortcode": "ABC123"
  }
 },
 {
  "name": "lower-case shortcode normalized to upper",
  "fn": "parse_posting",
  "args": [
   "https://apply.workable.com/acme/j/abc123/"
  ],
  "expect": {
   "account": "acme",
   "shortcode": "ABC123"
  },
  "ambiguous": true,
  "why": "Spec only says '<SHORTCODE>' and does not state case normalization; the case-format hint says lower-case shortcodes become upper case, but this is not in the spec sentence."
 },
 {
  "name": "other host returns None",
  "fn": "parse_posting",
  "args": [
   "https://www.workable.com/acme/j/ABC123/"
  ],
  "expect": null
 },
 {
  "name": "missing shortcode returns None",
  "fn": "parse_posting",
  "args": [
   "https://apply.workable.com/acme/j/"
  ],
  "expect": null
 },
 {
  "name": "missing account returns None",
  "fn": "parse_posting",
  "args": [
   "https://apply.workable.com/j/ABC123/"
  ],
  "expect": null
 },
 {
  "name": "extra path after shortcode",
  "fn": "parse_posting",
  "args": [
   "https://apply.workable.com/acme/j/ABC123/apply?x=1"
  ],
  "expect": {
   "account": "acme",
   "shortcode": "ABC123"
  }
 },
