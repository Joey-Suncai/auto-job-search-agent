 {
  "name": "plan_all_ok_with_verify",
  "files": {
   "plan.json": {
    "ats": "greenhouse",
    "url": "https://gh.example/1",
    "fields": [
     {
      "label": "L1",
      "answer": "a1",
      "status": "ok"
     },
     {
      "label": "L2",
      "answer": "a2",
      "status": "ok"
     }
    ]
   },
   "verify.json": {
    "pass": true,
    "bad": []
   }
  },
  "expect": {
   "ats": "greenhouse",
   "url": "https://gh.example/1",
   "n_rows": 2,
   "rows": [
    {
     "index": 0,
     "question": "L1",
     "planned": "a1",
     "page": "a1",
     "ok": true
    },
    {
     "index": 1,
     "question": "L2",
     "planned": "a2",
     "page": "a2",
     "ok": true
    }
   ]
  },
  "spec_quote": "A field is ok only when verify.json says pass: true, the field's label is not in verify.json bad, and the field's status is \"ok\"; then page = answer, otherwise page = null.",
  "ambiguous": false
 },
