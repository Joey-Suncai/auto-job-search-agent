<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//an employer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jobagent.refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd {{REPO}} &amp;&amp; {{PYTHON}} scripts/daily/run_daily.py refresh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>15</integer></dict>
  <key>StandardOutPath</key><string>/tmp/jobagent_refresh.log</string>
  <key>StandardErrorPath</key><string>/tmp/jobagent_refresh.err</string>
</dict>
</plist>
