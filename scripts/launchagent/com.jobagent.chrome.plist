<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//an employer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jobagent.chrome</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>{{REPO}}/skills/auto-apply/runner/run_chrome.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <!-- launchd runs Chrome itself (run_chrome.sh execs it). A crash restarts it after 30 s; a Chrome you quit
       on purpose (exit 0) stays closed until the next login. Never StartInterval: each tick killed the Chrome (JSA-378). -->
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/tmp/jobagent_chrome.log</string>
  <key>StandardErrorPath</key><string>/tmp/jobagent_chrome.err</string>
</dict>
</plist>
